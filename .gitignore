# ============================================================
# Optarb —— ETF 期权移仓风险监控（仓名拟：milan161/optarb）
# 仓库根 = D:\Study\ARB\Optarb
#
# 🔴 布局变更（2026-10-09）：仓根从旧的 src/ 迁到项目根，
#    data/ docs/ log/ shots/ .tmp/ 原先"天然在仓库外"，
#    现在必须显式排除。
#
# 治理原则（沿用 arbTest 开源治理 014）：
#   「白名单默认私有」—— 只有源码进仓；数据/日志/文档/凭据一律排除。
#   机密集中于 D:\Study\ARB\account_info（仓库外），本仓零凭据。
# ============================================================

# ------------------------------------------------------------
# 🔴 一、凭据与密钥（最高优先级，绝不入库）
# ------------------------------------------------------------
.env
**/.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
**/credentials*.json

# ------------------------------------------------------------
# 二、运行时数据（不传）
# ------------------------------------------------------------
#  主库 data/optarb.db（41MB）+ 期权行情/IV 表，全属运行产物。
data/
#  纵深防御：万一 db 落在 src 内，也绝不传。
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
**/*.bak*
**/*.bundle

# ------------------------------------------------------------
# 三、日志、截图与运行时状态（不传）
# ------------------------------------------------------------
log/
logs/
*.log
*.lock
# shots/ = 人工验证截图（4.6MB），.tmp/ = AI 临时截图与调试脚本
shots/
.tmp/

# ------------------------------------------------------------
# 四、内部文档与 AI 记忆（不传）
# ------------------------------------------------------------
#  docs/article/ 是东哥本人公开文章，但整体 docs/ 含内部设计文档，
#  暂按私有处理；如需开源文章，后续单独放public_docs/ 再放开。
docs/
.workbuddy/
.workbuddy-ai/
.codegraph/
.open-mem/
.opencode/
.omo/
agents.md
_ai_backup/
scratch/

# ------------------------------------------------------------
# 五、部署配置（不传 —— 含实例专属路径/主机信息）
# ------------------------------------------------------------
deploy/
# 注：start.bat / stop.bat 保留入库（纯本地启动器，无凭据）。

# ------------------------------------------------------------
# 六、本机代理 / VPN 脚本（不传）
# ------------------------------------------------------------
proxy.bat
Proxy.bat

# ------------------------------------------------------------
# 七、构建产物& 依赖
# ------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
*.pyd
.venv/
venv/
dist/
.vite/
.vite-*/
*.tsbuildinfo

